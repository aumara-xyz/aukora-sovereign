  "derivation": {
    "identity": "Each provided value is a person-nostr x-only public key encoded as exactly 32 raw bytes; hex below is lowercase. Key provenance belongs to the caller, never to a receipt, node id or device key.",
    "fixture_keys": "The successful inputs are the secp256k1 generator, its double and its triple x coordinates. No private key is a derivation input.",
    "order": "Sort the two raw 32-byte keys lexicographically as unsigned bytes, low before high. Argument order does not change the picture.",
    "pair_domain": "pentora.bloom.v1",
    "head": "SHA-256(UTF-8(pair_domain) || 0x00 || low || high)",
    "display_domain": "pentora.display.v1",
    "display_digest": "SHA-256(UTF-8(display_domain) || 0x00 || head), obtained through the Rust pentora_expand derivation.",
    "trits": "N is the big-endian unsigned integer of display_digest. Character i is floor(N / 3^i) mod 3 for i = 0..109, encoded as one of 0, 1, 2.",
    "cells": "Place trit i on mutable_indices[i] from the pinned geometry. The centre has no trit.",
    "absence": "A missing person key is null and produces no bloom. Empty or malformed provided bytes refuse. A bare commitment supplies neither person key and always refuses pentora:person-keys-required, including all-zero bytes.",
    "authority": "Display only. A bloom does not prove a meeting, authorize an operation or encode a health cell."
  },
