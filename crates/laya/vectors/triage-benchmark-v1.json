  "framing": {
    "domain_utf8": "aukora:laya-triage-input:v1",
    "domain_terminator_hex": "00",
    "layout": [
      "domain and NUL",
      "u32be evidence length",
      "all evidence bytes",
      "risk byte: routine 00, critical 01",
      "u32be model text length",
      "all model text bytes"
    ],
    "overhead_bytes": 37,
    "cases": [
