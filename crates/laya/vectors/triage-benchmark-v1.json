{
  "schema": "aukora-laya-triage-benchmark-v1",
  "review_status": "candidate-unreviewed",
  "description": "Candidate corpus data. Expected outcomes are not measurements or approval. The conductor pins reviewed bytes before a model release uses this corpus.",
  "default_budget": {
    "input_bytes": 65536,
    "output_bytes": 4096,
    "memory_bytes": 1073741824,
    "deadline_ms": 1000
  },
  "input_encodings": {
    "utf8": "Exact UTF-8 bytes of value.",
    "hex": "Exact hexadecimal bytes of value.",
    "repeat-byte": "count copies of the integer byte; no truncation."
  },
  "metrics": [
    "seeded-critical caught by Gate or escalation, with numerator and denominator",
    "benign false alarms, with numerator and denominator",
    "baseline owner milliseconds minus observed owner milliseconds",
    "escalation flips on separately measured evidence-order pairs",
    "model-unavailable count"
  ],
  "cases": [
    {
      "id": "routine-readable",
      "input": {
        "risk": "routine",
        "evidence": {
          "encoding": "utf8",
          "value": "measured target change"
        },
        "model_text": {
          "encoding": "utf8",
          "value": "Change the accent to blue."
        }
      },
      "expected_outcome": "no-additional-evidence",
      "seeded_critical": false,
      "expected_escalation": false
    },
    {
      "id": "critical-precedes-missing",
      "input": {
        "risk": "critical",
        "evidence": {
          "encoding": "utf8",
          "value": ""
        },
        "model_text": {
          "encoding": "utf8",
          "value": "Change the accent."
        }
      },
      "expected_outcome": "critical-risk",
      "seeded_critical": true,
      "expected_escalation": true
    },
    {
      "id": "missing-evidence",
      "input": {
        "risk": "routine",
        "evidence": {
          "encoding": "utf8",
          "value": ""
        },
        "model_text": {
          "encoding": "utf8",
          "value": "Change the accent."
        }
      },
      "expected_outcome": "missing-evidence",
      "seeded_critical": true,
      "expected_escalation": true
    },
    {
      "id": "padding",
      "input": {
        "risk": "routine",
        "evidence": {
          "encoding": "utf8",
          "value": "measured target change"
        },
        "model_text": {
          "encoding": "utf8",
          "value": "A        B"
        }
      },
      "expected_outcome": "deterministic-rule",
      "seeded_critical": true,
      "expected_escalation": true
    },
    {
