  "derivation": {
    "identity": "exactly 32 raw bytes, written as 64 lowercase hex digits; any other length refuses pentora:identity-invalid",
    "pair": "two identities that differ; both lengths are checked first, the first identity before the second, then equal identities refuse pentora:identities-equal",
    "order": "low and high are the two identities in bytewise order, so first and second may be given in either order",
    "digest": "sha256(UTF-8 bytes of domain || 0x00 || low || high)",
    "commitment": "a 32-byte commitment is drawn as it is, with no further hash; all zero refuses pentora:commitment-empty",
    "trits": "N is the big-endian integer of the digest; trit i is floor(N / 3^i) mod 3 for i = 0..109",
    "text": "trits is 110 characters, each 0, 1 or 2; character i is wire byte i of the expansion",
    "cells": "trit i is drawn on the i-th non-centre cell: global cell i for i below 55, global cell i + 1 from 55"
  },
