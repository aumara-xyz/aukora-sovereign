{
  "schema": "aukora-verifier-standing-regressions-v1",
  "assembly": {
    "primitive_definitions": "Use the C1, C3, Ed25519, RFC 6962 and independent bundle-observation definitions in gate-regressions-v1.json.",
    "signing_seed_hex": "2525252525252525252525252525252525252525252525252525252525252525",
    "publicKey": "bed7d2ab668da3efad613998f06f7abf7875f3a6b7677a9f3ce947d77d7760a6",
    "var": "Resolve a var from the current operation block's parameters.",
    "local": "Resolve a local from the current block's instantiated operation_template.",
    "derive": {
      "base_digest": "The literal string absent for JSON null; otherwise lowercase hexadecimal SHA-256 of the base UTF-8 string.",
      "repeat": "Repeat the resolved value exactly count times; concatenate strings or concatenate copies of the resolved array.",
      "standing_reference": "The exact six-key object {v:1,proposal:source.auth.proposal,authorization_sha256:source.authorization_sha256,proof_sha256:source.proof_sha256,consume:{seq:source.consume.seq,hash:source.consume.hash},kind:put} from the named earlier block.",
      "authorizing_digest": "Use the current authorization_sha256 for a direct block, or standing_reference.authorization_sha256 for a standing block.",
      "consumption_proof_sha256": "The current block's assembled consume_body.proof_sha256, including the standing-reference override."
    },
    "defaults": "Merge block parameters over block_defaults. A template_edits entry changes only its named block's template before commitments are derived. A standing_edits entry changes that block's resolved six-key reference before it is copied into consumption and receipt. Replace edits to block parameters may introduce an override absent from that block's explicit members.",
    "case_overrides": "Inherit base_case recursively, substitute the current variants entry, merge extra_blocks, apply block_edits and policy_edits, then instantiate templates. Child edit lists append to inherited lists; an explicit child schedule replaces the inherited schedule. Append append_schedule after the chosen schedule.",
    "direct_consumption": "Emit consume_body. For a standing block omit proof_hex, add standing_permission equal to its resolved reference, and replace proof_sha256 with that reference's proof_sha256.",
    "receipt": "For a standing block set receipt.standing_permission to the exact resolved reference; for a direct block set it to null. Resolve authorizing_digest after this choice.",
    "sequence": "Follow schedule in array order, emitting only the named phases of each block. Assign contiguous one-based seq and predecessor hashes. Propose, review and consume use block.at; apply uses block.apply_at. A phase_at entry overrides its selected row time. When receipt_time_from_phase_at is true, also set receipt.applied_at and owner_accepted_at_ms to that overridden apply row time.",
    "references": "Resolve row_reference tags by block and phase after earlier rows are signed. Include ledger_seq and ledger_hash aliases when aliases is true. Additional members are recursively resolved and merged.",
    "row_edits": "After resolving a row's body, references and commitments, apply edits for that block and phase, then recompute that row's C3 hash/signature. Later generated references use the resulting hashes.",
    "terminal_override": "Replace the apply row's kind and body with terminal_override, preserving its operation id, terminal phase and configured time. When terminal_variants is present, select by variant.terminal and use its value as blocks.auto.terminal_override; null preserves normal application.",
    "case_isolation": "Every case and every variants entry starts from an independent baseline; block_edits address this authoring document, not an exported v1 object.",
    "verification": "Rebuild the final head after all rows are signed and supply it plus publicKey independently to both verifiers."
  },
