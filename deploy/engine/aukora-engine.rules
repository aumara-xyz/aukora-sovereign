// The supervisor (user aukora) may start, stop, restart and reset-failed exactly one unit, the engine, and start its
// root cleanup oneshot (engine-run.sh delete after a failed stop; Sonnet sweep C2). Nothing else.
polkit.addRule(function(action, subject) {
    if (action.id == "org.freedesktop.systemd1.manage-units" && subject.user == "aukora") {
        var unit = action.lookup("unit");
        var verb = action.lookup("verb");
        if (unit == "aukora-engine.service" &&
            (verb == "start" || verb == "stop" || verb == "restart" || verb == "reset-failed")) {
            return polkit.Result.YES;
        }
        if (unit == "aukora-engine-cleanup.service" && verb == "start") {
            return polkit.Result.YES;
        }
    }
});
