[Unit]
Description=AUKORA Sovereign node supervisor
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=aukora
Group=aukora
ExecStart=/usr/local/bin/sovereign serve --config /etc/aukora/node.json
WorkingDirectory=/var/lib/aukora
StateDirectory=aukora
StateDirectoryMode=0700
UMask=0077
Delegate=yes
# Start in the leaf the supervisor uses: after a run its cgroup enables controllers for
# guest/ and supervisor/, so a restart cannot place the new process at the top (219/CGROUP).
DelegateSubgroup=supervisor
Restart=on-failure
RestartSec=3s
KillMode=control-group
TimeoutStopSec=5s
# newuidmap/newgidmap are setuid helpers; NoNewPrivileges=yes would block them.
NoNewPrivileges=no
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/aukora /var/lib/aukora-guest
PrivateTmp=yes
ProtectKernelModules=yes
# Not set, on purpose: ProtectKernelTunables and ProtectKernelLogs lay read-only mounts over
# parts of /proc, and the kernel then refuses the guest's fresh /proc inside its user
# namespace; PrivateDevices hides LXD's clean /proc copy (/dev/.lxc/proc) for the same
# reason. The guest gets its own minimal /dev and /proc from the launcher instead.
ProtectClock=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
# User/mount/network namespaces, delegated cgroups and uidmap helpers are required.
RestrictNamespaces=no
ProtectControlGroups=no
# Node and native addons need executable mappings inside the guest.
MemoryDenyWriteExecute=no
LimitNOFILE=4096
LimitCORE=0

[Install]
WantedBy=multi-user.target
