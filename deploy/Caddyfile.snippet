# The upstream accepts only these configured loopback proxy peers.
owner-node.example.com, chat-node.example.com {
    reverse_proxy 127.0.0.1:18080 {
        header_up Host {host}
        header_up X-Forwarded-Host {host}
        header_up X-Forwarded-Proto https
        header_up X-Forwarded-For {remote_host}
        header_up -Forwarded
    }
    # Do not enable access logging: claim links contain one-time query tokens.
}
