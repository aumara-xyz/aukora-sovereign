# The local OpenShell 0.1.4 gateway (docker compute driver) the engine sandbox runs under. Loopback only; its keys
# live in /var/lib/aukora-openshell (root 0700). Settings: /etc/aukora/engine/openshell-gateway.toml (wall test,
# finding 3). [GUESS] the --config spelling: use the wall-test VM's gateway command line if it differs.
[Unit]
Description=AUKORA OpenShell gateway for the engine sandbox
After=docker.service network-online.target
Requires=docker.service

[Service]
Type=exec
Environment=OPENSHELL_TELEMETRY_ENABLED=false HOME=/var/lib/aukora-openshell
ExecStart=/usr/local/bin/openshell-gateway --config /etc/aukora/engine/openshell-gateway.toml
Restart=on-failure
RestartSec=5s
StateDirectory=aukora-openshell
StateDirectoryMode=0700
UMask=0077

[Install]
WantedBy=multi-user.target
