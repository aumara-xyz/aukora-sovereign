# The local OpenShell 0.1.4 gateway (docker compute driver) the engine sandbox runs under. Loopback only; its PKI
# (made by engine_install.py with the gateway's own generate-certs) lives in /var/lib/aukora-openshell
# (root 0700, the HOME below). Settings: /etc/aukora/engine/openshell-gateway.toml.
[Unit]
Description=AUKORA OpenShell gateway for the engine sandbox
After=docker.service network-online.target aukora-engine-fence.service
Requires=docker.service aukora-engine-fence.service
StartLimitIntervalSec=0

[Service]
Type=exec
Environment=OPENSHELL_TELEMETRY_ENABLED=false HOME=/var/lib/aukora-openshell
# OpenShell's own startup recovery bypasses AUKORA admission if running intent survives a gateway restart.
# Keep only PKI/CLI registration persistent; forget sandbox intent and remove old containers before every launch.
# --db-url sqlite::memory: is supported by the pinned 0.1.4 CLI; a TOML database_url key is rejected.
ExecStartPre=/opt/aukora/current/deploy/engine/engine-run.sh gateway-clean
ExecStart=/usr/local/bin/openshell-gateway --config /etc/aukora/engine/openshell-gateway.toml --db-url sqlite::memory:
Restart=on-failure
RestartSec=5s
RestartSteps=6
RestartMaxDelaySec=300s
# Keep the gateway's control plane ahead of the engine workload under host memory pressure.
OOMScoreAdjust=-500
LimitCORE=0
StateDirectory=aukora-openshell
StateDirectoryMode=0700
UMask=0077
# Grok review of the node commit, part 7 #1. Root, because it drives docker (whose socket is root-equivalent anyway),
# but with nothing else: it listens on a privileged loopback port (690, openshell-gateway.toml), so no other local user
# can bind that port during a restart gap and pose as the gateway, and the fence lets only root and 65534 connect to it
# (root's CLI; each sandbox's supervisor container, which OpenShell 0.1.4 runs as 65534 on the host network; both still
# authenticate: mTLS, a sandbox-scoped JWT). The one capability kept is binding that port; the node rehearsal of
# 2026-10-17 ran the gateway under exactly these lines (check-units.sh: units ok).
ReadWritePaths=/run/docker.sock
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
IPAddressDeny=any
IPAddressAllow=localhost
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
SystemCallArchitectures=native
SystemCallFilter=@system-service

[Install]
WantedBy=multi-user.target
