# The engine (deploy/engine/NODE.md): the DeepSeek Harness inside OpenShell. No [Install] section: it never starts at
# boot by itself. Only the supervisor starts and stops it (polkit allows user aukora exactly this unit), and only
# while the owner is bound, the approved release is installed, the door is configured and an owner-approved plugin
# set matches. This unit runs as root only to drive the local OpenShell gateway; the engine inside runs as auma.
[Unit]
Description=AUKORA engine: the DeepSeek Harness inside OpenShell (Ring 1)
After=docker.service aukora-openshell-gateway.service aukora-engine-fence.service aukora-kira.service aukora-sovereign.service
Requires=aukora-openshell-gateway.service aukora-engine-fence.service
# The bridge folder is a host tmpfs (run-aukora\x2dengine-io.mount, from deploy/engine/aukora-engine-io.mount.in).
RequiresMountsFor=/run/aukora-engine/io
# Stopping or restarting the supervisor stops the engine; it comes back only when the supervisor starts it again.
PartOf=aukora-sovereign.service
AssertPathExists=/etc/aukora/engine-v1.json
AssertPathExists=/etc/aukora/engine.env
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=exec
# No admission from the supervisor's current run: the start is skipped (not failed, so no restart loop and no start
# limit), and the supervisor starts the unit itself once it has decided (Grok review of the node commit, part 2 #2).
ExecCondition=/usr/bin/test -f /run/aukora-engine-ctl/admission.json
ExecStartPre=/opt/aukora/current/deploy/engine/engine-prestart.sh
ExecStart=/opt/aukora/current/deploy/engine/engine-run.sh create
ExecStartPost=/opt/aukora/current/deploy/engine/engine-run.sh verify
ExecStopPost=/opt/aukora/current/deploy/engine/engine-run.sh delete
# The OpenShell CLI exits 143 when systemd stops it with SIGTERM: that is a clean stop, not a failure (node rehearsal:
# every stop left the unit failed, which the supervisor rightly reads as "the sandbox may still be up").
SuccessExitStatus=143
Restart=on-failure
RestartSec=10s
TimeoutStartSec=180s
# The stop bounds ExecStopPost too: OpenShell's asynchronous delete, engine-run.sh's 10 s wait and its docker rm -f
# fallback must all fit, or a hung sandbox outlives the stop (Sonnet sweep C3).
TimeoutStopSec=90s
NoNewPrivileges=yes
ProtectHome=yes
PrivateTmp=yes
ProtectKernelModules=yes
ProtectClock=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
