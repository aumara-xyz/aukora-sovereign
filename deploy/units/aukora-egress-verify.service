# Re-checks that the live firewall table and the policy file are what aukora-egress.service loaded, and rewrites the
# status file (rows 70 and 102). It fails, and says so in the status file, when they differ. Started by the timer.
[Unit]
Description=AUKORA egress allowlist re-check
After=aukora-egress.service

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 -B /opt/aukora/current/deploy/units/egress_apply.py verify
RuntimeDirectory=aukora-egress
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes
UMask=0077

CapabilityBoundingSet=CAP_NET_ADMIN
NoNewPrivileges=yes
RestrictAddressFamilies=AF_NETLINK AF_UNIX
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
