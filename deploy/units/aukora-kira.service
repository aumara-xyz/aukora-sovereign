# Kira 2 on the node: `sovereign kira serve` as user kira. Its socket (0660, group kira-clients) is reachable by the
# supervisor's door only; the engine never sees it. Agents: the door's token is a non-owner agent (auma); the owner's
# token is root's alone (/root/aukora-kira-owner.token), for the owner's own tools. Without the model servers recall
# runs on keywords and says so.
[Unit]
Description=AUKORA Kira 2 shared memory
After=aukora-kira-embed.service aukora-kira-rerank.service
Wants=aukora-kira-embed.service aukora-kira-rerank.service
# The model servers' private network namespace: Kira reaches 127.0.0.1:8771/8772 there and nowhere else.
JoinsNamespaceOf=aukora-kira-embed.service
Before=aukora-sovereign.service
StartLimitIntervalSec=0

[Service]
Type=exec
User=kira
Group=kira
Environment=KIRA_EMBED_ADDR=127.0.0.1:8771 KIRA_EMBED_MODEL=06507c7b42688469c4e7298b0a1e16deff06caf291cf0a5b278c308249c3e439
Environment=KIRA_RERANK_ADDR=127.0.0.1:8772 KIRA_RERANK_MODEL=a43c7c9b11a4c1517e5bf95151960e1621d1b72f7a493364b01e386cf1aaa1d3
ExecStart=/opt/aukora/current/bin/sovereign kira serve --state /var/lib/aukora-kira --socket /run/aukora-kira/kira.sock --group-socket
Restart=on-failure
RestartSec=3s
RestartSteps=6
RestartMaxDelaySec=300s
StateDirectory=aukora-kira
StateDirectoryMode=0700
ReadWritePaths=/run/aukora-kira
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateNetwork=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_INET AF_UNIX
IPAddressDeny=any
IPAddressAllow=localhost
CapabilityBoundingSet=
SystemCallArchitectures=native
SystemCallFilter=@system-service

[Install]
WantedBy=multi-user.target
