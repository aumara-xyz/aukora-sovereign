# Kira 2's rerank model: llama.cpp llama-server on CPU, loopback 8772 only, as user kira. The alias is the model file's
# SHA-256 (deploy/engine/engine-pins.json): Kira checks /v1/models serves exactly it, so a swapped file refuses.
[Unit]
Description=AUKORA Kira 2 rerank model (llama.cpp, CPU, loopback)
After=aukora-engine-fence.service
Wants=aukora-engine-fence.service

[Service]
Type=exec
User=kira
Group=kira
ExecStart=/opt/aukora-kira/llama/llama-server -m /opt/aukora-kira/models/rerank.gguf --alias a43c7c9b11a4c1517e5bf95151960e1621d1b72f7a493364b01e386cf1aaa1d3 --reranking -np 1 -c 2048 -b 2048 -ub 2048 -t 2 --host 127.0.0.1 --port 8772
Restart=on-failure
RestartSec=5s
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_INET AF_UNIX
IPAddressDeny=any
IPAddressAllow=localhost
CapabilityBoundingSet=
SystemCallArchitectures=native
SystemCallFilter=@system-service
UMask=0077

[Install]
WantedBy=multi-user.target
